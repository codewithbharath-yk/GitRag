# =====================================================================
# CodeRAG Production Configuration & Environment Variables
# Copy this file to .env and configure real keys for deployment.
# NEVER commit your actual .env file with secrets to Git!
# =====================================================================

# --- Application Configuration ---
APP_NAME=CodeRAG
APP_ENV=development # development | production | testing
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0
LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR

# --- Google Gemini AI Configuration (Chat & Answer Generation) ---
# Generate at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter Embedding & LLM Configuration ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Provider Selection ---
EMBEDDING_PROVIDER=openrouter # openrouter | gemini
LLM_PROVIDER=gemini           # gemini | openrouter

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks
QDRANT_TIMEOUT_SECONDS=15.0

# --- GitHub Integration ---
# Optional Personal Access Token for 5,000 req/hr rate limits & private repository access
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=30.0

# --- Authentication & JWT Security ---
AUTH_ENABLED=true
JWT_SECRET_KEY=coderag-change-me-to-a-secure-random-32-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://your-frontend-app.vercel.app

# --- Supabase Database & Auth (Optional Cloud Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Resource & Security Limits ---
MAX_REPO_SIZE_MB=150
MAX_FILES_PER_REPO=500
MAX_FILE_SIZE_BYTES=524288 # 512 KB
MAX_CHUNKS_PER_REPO=5000
MAX_CONCURRENT_INDEXING_JOBS=3
MAX_QUERY_RETRIEVAL_COUNT=20
