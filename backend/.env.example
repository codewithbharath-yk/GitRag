# =====================================================================
# CodeRAG Backend Environment Configuration (.env)
# =====================================================================

APP_NAME=CodeRAG
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Google Gemini AI (Answer Generation) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Local Embedding Model (BAAI/bge-small-en-v1.5) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Qdrant Vector Store (Cloud or Self-Hosted) ---
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=code_chunks
QDRANT_TIMEOUT_SECONDS=15.0

# --- GitHub Integration ---
GITHUB_TOKEN=your_optional_github_token_here
GITHUB_API_BASE_URL=https://api.github.com

# --- Security & CORS ---
AUTH_ENABLED=true
JWT_SECRET_KEY=your_random_32_character_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173
