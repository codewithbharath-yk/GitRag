# Production FastAPI Backend Base URL (e.g., https://coderag-api.onrender.com)
# In development, leave empty or set to http://127.0.0.1:8000
VITE_API_BASE_URL=https://YOUR_BACKEND_API_URL

# Legacy/Alternative variable alias
VITE_BACKEND_URL=https://YOUR_BACKEND_API_URL
